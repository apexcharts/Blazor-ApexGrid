<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Blazor_ApexGrid</RootNamespace>

    <PackageId>Blazor-ApexGrid</PackageId>
    <Title>Blazor ApexGrid</Title>
    <Description>A Blazor wrapper for apex-grid, a Lit-based web-component data grid. The core library is bundled and shipped inside the package (no script tag or CDN needed).</Description>
    <Authors>ApexCharts</Authors>
    <Company>ApexCharts</Company>
    <Copyright>Copyright 2026 ApexCharts</Copyright>
    <PackageTags>blazor;grid;datagrid;apex-grid;table;webassembly;server;blazor-server</PackageTags>
    <RepositoryUrl>https://github.com/apexcharts/Blazor-ApexGrid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/apexcharts/Blazor-ApexGrid</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>

    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <PackageReleaseNotes>
      1.3.0 Bundles apex-grid 5.0.0 (1.2.1 bundled 4.0.1). ShowHeader, ShowQuickFilter, ShowExport and ExportFilename parameters; PaginationConfiguration.Paginator (Full or Compact), and a Pagination change after the first render now reaches the grid; GridDataType.Chart with GridColumn.Chart, which draws with an ApexCharts 8.4.1 or later that the app loads itself (not bundled). The grid chrome is now sized in px, so it keeps its designed size on pages whose root font size is not 16px. The core bundle shares its apex-grid core and Lit with the new Blazor-ApexGrid-Enterprise package, so a page with community and enterprise grids holds one core. ApexGrid&lt;TItem&gt; opens a small seam for derived components: ExtendConfig, ElementId, IsInitialized and GetModuleAsync are protected, and the interop module's init takes an applyConfig function from a wrapping module. The ?ver= cache busters now carry the package version (1.3.0), since the vendored files changed without a core bump. Nothing a .NET caller uses is removed.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The ?ver= cache busters are kept equal by hand, so the build checks them: each one in the
       interop module and in ApexGrid.razor's ModulePath must be the <Version> written above (read
       from this file, so a /p:Version from a workflow does not count). Blazor-ApexGrid-Enterprise's
       build checks its import of blazor-apexgrid.js against the same <Version>. -->
  <Target Name="CheckCacheBusters" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_SourceVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildProjectFullPath)')), '(?s)^.*?&lt;Version&gt;\s*([^&lt;\s]+)\s*&lt;/Version&gt;.*$', '$1'))</_SourceVersion>
      <_VersionPattern>$(_SourceVersion.Replace('.', '\.'))</_VersionPattern>
      <_VerText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/wwwroot/js/blazor-apexgrid.js'))$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Components/ApexGrid.razor'))</_VerText>
      <_VerStale>$([System.Text.RegularExpressions.Regex]::IsMatch($(_VerText), '\?ver=(?!$(_VersionPattern)[^\w.-])[\w.]'))</_VerStale>
    </PropertyGroup>
    <Error Condition="'$(_VerStale)' == 'True'" Text="Every ?ver= in wwwroot/js/blazor-apexgrid.js and Components/ApexGrid.razor must be this package's version, $(_SourceVersion)." />
  </Target>

</Project>
