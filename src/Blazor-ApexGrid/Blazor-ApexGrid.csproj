<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Blazor_ApexGrid</RootNamespace>

    <PackageId>Blazor-ApexGrid</PackageId>
    <Title>Blazor ApexGrid</Title>
    <Description>A Blazor wrapper for apex-grid, a Lit-based web-component data grid. The core library is bundled and shipped inside the package (no script tag or CDN needed).</Description>
    <Authors>ApexCharts</Authors>
    <Company>ApexCharts</Company>
    <Copyright>Copyright 2026 ApexCharts</Copyright>
    <PackageTags>blazor;grid;datagrid;apex-grid;table;webassembly;server;blazor-server</PackageTags>
    <RepositoryUrl>https://github.com/apexcharts/Blazor-ApexGrid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/apexcharts/Blazor-ApexGrid</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>

    <Version>1.2.0-beta.1</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <PackageReleaseNotes>
      1.2.0-beta.1 Prerelease. Bundles apex-grid 4.0.0-beta.2 (was 3.6.0). New: opt-in Ignite UI theming, turned on once with ApexGridIgniteUI.Enable(); per grid, DesignSystem="false" turns the Ignite UI colours and font off and Tokens="false" turns off the family --apx-* tokens too. Behaviour to note: an Ignite UI stylesheet on the page no longer re-tints the grid brand or replaces its font until ApexGridIgniteUI.Enable() is called; body rows are recycled on scroll, sort and filter; the grid role and row counts moved from the apex-grid host to its inner table part; with pagination, pinned rows no longer count toward the pages.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
