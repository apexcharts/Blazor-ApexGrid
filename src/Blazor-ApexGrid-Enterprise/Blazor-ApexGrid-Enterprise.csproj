<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Blazor_ApexGrid_Enterprise</RootNamespace>

    <PackageId>Blazor-ApexGrid-Enterprise</PackageId>
    <Title>Blazor ApexGrid Enterprise</Title>
    <Description>The enterprise companion to Blazor-ApexGrid: an ApexGridEnterprise component for apex-grid-enterprise with row grouping, aggregations, pivoting, a grand-total row, cell range selection, a context menu and XLSX export. The enterprise bundle ships inside the package and reuses the apex-grid core from Blazor-ApexGrid. A commercial product: a Premium license or higher is required, and without a license key the grid renders a trial watermark.</Description>
    <Authors>ApexCharts</Authors>
    <Company>ApexCharts</Company>
    <Copyright>Copyright 2026 ApexCharts</Copyright>
    <PackageTags>blazor;grid;datagrid;apex-grid;apex-grid-enterprise;pivot;grouping;aggregation;excel;xlsx;webassembly;server;blazor-server</PackageTags>
    <RepositoryUrl>https://github.com/apexcharts/Blazor-ApexGrid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/apexcharts/Blazor-ApexGrid</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <PackageReleaseNotes>
      0.1.0 First release. Bundles apex-grid-enterprise 0.10.0 and reuses the apex-grid 5.0.0 core and Lit from Blazor-ApexGrid 1.4.0, so a page with both packages holds one core. ApexGridEnterprise&lt;TItem&gt; extends ApexGrid&lt;TItem&gt; with GroupBy and GroupingOptions, Aggregations, TotalRow, Pivot, RangeSelection, ContextMenu (custom items raise OnContextMenuItemClick) and XLSX export, plus OnRangeChanged and OnGroupExpanded. The license key and the feature modules are set once with AddApexGridEnterprise or ApexGridEnterprise.SetLicense. Not yet modelled: the server-side and infinite row models, master/detail, formulas, integrated charts, the AI toolkit and the six companion elements.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Packs as a NuGet dependency on Blazor-ApexGrid (this project's version), not a copy of it:
       the enterprise bundle reads the core that package serves from _content/Blazor-ApexGrid/. -->
  <ItemGroup>
    <ProjectReference Include="..\Blazor-ApexGrid\Blazor-ApexGrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The ?ver= cache busters are kept equal by hand, so the build checks them: the interop module
       must import Blazor-ApexGrid's module at that project's <Version> (another URL would evaluate
       the community module twice), and this package's own URLs carry this package's <Version>.
       Both are read from the csproj files, so a /p:Version from a workflow does not count. -->
  <Target Name="CheckCacheBusters" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_VersionInCsproj>(?s)^.*?&lt;Version&gt;\s*([^&lt;\s]+)\s*&lt;/Version&gt;.*$</_VersionInCsproj>
      <_CoreVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../Blazor-ApexGrid/Blazor-ApexGrid.csproj')), $(_VersionInCsproj), '$1'))</_CoreVersion>
      <_OwnVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildProjectFullPath)')), $(_VersionInCsproj), '$1'))</_OwnVersion>
      <_CoreVersionPattern>$(_CoreVersion.Replace('.', '\.'))</_CoreVersionPattern>
      <_OwnVersionPattern>$(_OwnVersion.Replace('.', '\.'))</_OwnVersionPattern>
      <_InteropText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/wwwroot/js/blazor-apexgrid-enterprise.js'))</_InteropText>
      <_OwnText>$(_InteropText)$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Components/ApexGridEnterprise.cs'))</_OwnText>
      <_CoreUrlStale>$([System.Text.RegularExpressions.Regex]::IsMatch($(_InteropText), 'blazor-apexgrid\.js\?ver=(?!$(_CoreVersionPattern)[^\w.-])'))</_CoreUrlStale>
      <_CoreUrlFound>$(_InteropText.Contains('blazor-apexgrid.js?ver=$(_CoreVersion)'))</_CoreUrlFound>
      <_OwnUrlStale>$([System.Text.RegularExpressions.Regex]::IsMatch($(_OwnText), '(apex-grid-enterprise\.bundle|blazor-apexgrid-enterprise)\.js\?ver=(?!$(_OwnVersionPattern)[^\w.-])'))</_OwnUrlStale>
    </PropertyGroup>
    <Error Condition="'$(_CoreUrlStale)' == 'True' or '$(_CoreUrlFound)' != 'True'" Text="wwwroot/js/blazor-apexgrid-enterprise.js must import blazor-apexgrid.js?ver=$(_CoreVersion), the version of the referenced Blazor-ApexGrid project." />
    <Error Condition="'$(_OwnUrlStale)' == 'True'" Text="Every apex-grid-enterprise.bundle.js and blazor-apexgrid-enterprise.js ?ver= in wwwroot/js/blazor-apexgrid-enterprise.js and Components/ApexGridEnterprise.cs must be this package's version, $(_OwnVersion)." />
  </Target>

</Project>
